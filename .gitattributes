# Best Treks Nepal — .gitattributes
# Normalize line endings consistently across OS

# Auto-detect text files and normalize
* text=auto

# HTML/CSS/JS — use LF
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# Binary files — no line ending conversion
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
