# ============================================================
# Best Treks Nepal — .gitignore
# Static HTML/CSS/JS website + Node.js dev tooling
# ============================================================


# ── Node.js / npm ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
package-lock.json


# ── Dev server & build output ────────────────────────────────
dist/
build/
.cache/
scratch/
.parcel-cache/
.vite/


# ── Scratch / internal dev scripts ───────────────────────────
# These are one-off automation scripts, not part of the website
scratch/


# ── Environment & secrets ────────────────────────────────────
.env
.env.local
.env.*.local
*.env
secrets.json
config.local.js


# ── OS-generated files ───────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory


# ── IDE & editor settings ────────────────────────────────────
# VS Code (keep .vscode/settings.json if team-shared, ignore personal)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains (WebStorm, PHPStorm, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#


# ── Logs & diagnostics ───────────────────────────────────────
logs/
*.log
*.log.*
crash.log
error.log


# ── Temporary & generated files ──────────────────────────────
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej


# ── Image editing originals (keep only web-optimised exports) ─
*.psd
*.ai
*.sketch
*.fig
*.xd


# ── Antigravity / AI agent internals ─────────────────────────
# Keep .agents/ skills & rules (they're part of the project)
# but ignore any runtime/cache data
.agents/.cache/
.agents/logs/


# ── Optional: ignore internal utility pages from tracking ─────
# Uncomment if you don't want these in version control:
# all-pages.html
# pages.html
